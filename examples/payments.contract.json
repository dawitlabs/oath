{
  "service": "payments",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/charges/{id}",
      "responses": {
        "200": {
          "fields": {
            "id": { "type": "string", "presence": "always" },
            "amount": { "type": "number", "presence": "always" },
            "legacy_id": { "type": "string", "presence": "sometimes" }
          }
        }
      }
    }
  ]
}
